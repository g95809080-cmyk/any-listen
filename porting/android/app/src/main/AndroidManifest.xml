<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 本地 127.0.0.1 回环 + 在线音源 / WebDAV 都需要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 本地音乐库：Android 11+ 走「所有文件访问」，API 29 走 requestLegacyExternalStorage -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- 后台播放四件套（R-09） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 读取网络状态用于"仅 Wi-Fi 下载"类设置；Android 12+ 需要显式声明 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11+ 包可见性：openUrl / 分享需要能查到浏览器与分享目标 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".AnyListenApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnyListen"
        android:networkSecurityConfig="${networkSecurityConfig}"
        tools:targetApi="35">

        <!--
          明文流量策略由 res/xml/network_security_config.xml 决定（不再用全局 usesCleartextTraffic）：
          1. 回环 127.0.0.1 / localhost 允许明文 —— 本地回环服务 + AudioWorklet 的 secure context 前提；
          2. Online Metadata 0.4.8 实际使用的 34 个精确主机允许明文，全部 includeSubdomains="false"；
          3. 其余域名默认 cleartextTrafficPermitted="false"，在线音源必须走 https；
          4. 需要 http 音源时，把**具体域名**加进那份 XML 的 domain-config，不要写通配；
             临时排查可用 -PallowCleartext=true 切到宽松配置（manifest placeholder 切换，见 build.gradle.kts）。
          注意这条策略对 OkHttp 同样生效（NetworkSecurityPolicy 在连接前检查），原生代发也会被拦。
        -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AnyListen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台播放服务：type=mediaPlayback（Android 14 起必须显式声明类型） -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- 耳机键 / 蓝牙按键：没有它，锁屏与耳机线控全部失效 -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 导出备份/日志用；authority 必须与 IntentPortImpl 默认值一致（${packageName}.fileprovider） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
